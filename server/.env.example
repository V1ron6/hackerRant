PORT=5000
NODE_ENV=development

# Postgres (Neon) — use the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Set to false only for a local Postgres without TLS
# DB_SSL=false

# Redis (Upstash)
REDIS_URL=redis://default:password@your-upstash-url:6379

# JWT
JWT_SECRET=replace_with_long_random_secret

# Cookie
COOKIE_SECRET=replace_with_long_random_secret

# CORS — your Vercel frontend URL
CLIENT_URL=https://hackerrant.vercel.app

# Email — Mailjet Send API (HTTPS; Render blocks SMTP). MAIL_FROM must be a sender
# address you have verified in Mailjet.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=noreply@hackerrant.com
MAIL_FROM_NAME=hackerRant
# true = Mailjet validates the request but delivers nothing (safe for testing)
# MAILJET_SANDBOX=true
# true = run the email worker inside the API process (otherwise: npm run worker)
RUN_EMAIL_WORKER=true

# Uploads — local (dev) or r2 (Cloudflare R2, S3-compatible)
STORAGE_DRIVER=local
# Public URL of this API, used to build links to locally stored uploads
PUBLIC_URL=http://localhost:5000
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Comma-separated usernames allowed to create Ranres resources
ADMIN_USERNAMES=

# Twilio (optional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
