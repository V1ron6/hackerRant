PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hackerrant
DB_USER=root
DB_PASS=

# Redis (Upstash)
REDIS_URL=redis://default:password@your-upstash-url:6379

# JWT
JWT_SECRET=replace_with_long_random_secret

# Cookie
COOKIE_SECRET=replace_with_long_random_secret

# CORS — your Vercel frontend URL
CLIENT_URL=https://hackerrant.vercel.app

# Email (use Resend or similar HTTP-based provider — Render blocks SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=noreply@hackerrant.com

# Twilio (optional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
